node {

    def mvnHome = tool 'maven3'

    stage('clone') {
        checkout scm
    }

    stage('build') {
        sh 'java -version'
        sh "${mvnHome}/bin/mvn -version"
        sh "${mvnHome}/bin/mvn clean package"
    }

    stage('test') {
        sh "${mvnHome}/bin/mvn test"
    }

    stage('archive') {
        archiveArtifacts artifacts: 'target/*.war', fingerprint: true
    }
}
