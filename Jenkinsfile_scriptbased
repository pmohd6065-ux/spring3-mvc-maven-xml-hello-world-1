node {

    stage('clone') {
        checkout scm
    }

    stage('build') {
        sh 'java -version'
        sh 'mvn -version'
        sh 'mvn clean package'
    }

    stage('test') {
        sh 'mvn test'
    }

    stage('archive') {
        archiveArtifacts artifacts: 'target/*.war', fingerprint: true
    }
}
